# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- PostgreSQL ---
# Passwort des Datenbank-Owners (Superuser). Pflicht fuer Docker Compose.
# Nur URL-sichere Zeichen (Buchstaben, Ziffern, - und _): es steht in Verbindungs-URLs.
# Erzeugen z.B. mit: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
# lokal (ohne Docker-API-Container), Passwort wie oben.
# 127.0.0.1 statt localhost: Die Datenbank lauscht nur auf IPv4. "localhost" versucht
# unter Windows zuerst IPv6 und haengt dort pro Verbindung bis zum Timeout.
DATABASE_URL=postgresql+psycopg://mailagent:POSTGRES_PASSWORD_HIER@127.0.0.1:5432/mailagent

# --- Langfuse (optional, App startet auch ohne) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- IMAP-Postfach (Dauerbetrieb) ---
# Outlook: outlook.office365.com | Gmail: imap.gmail.com (App-Passwort noetig)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_SSL=true
# Nur Mails ab diesem Datum holen, z.B. 2026-09-01 (leer = alle im Ordner)
IMAP_SINCE=

# --- Automatischer Abruf ---
WATCH_ENABLED=true
# Uhrzeiten in lokaler Serverzeit (siehe TZ), kommagetrennt
POLL_TIMES=00:00,12:00,18:00
POLL_BATCH_SIZE=50
# Postfaecher auf internen Adressen (127.0.0.1, 10.x, ...) zulassen - nur fuer einen lokalen Test-IMAP
ALLOW_PRIVATE_IMAP_HOSTS=false
# Zeitzone des Containers - bestimmt, wann POLL_TIMES feuert
TZ=Europe/Berlin

# --- Docker Host-Ports (nur falls die Standardports belegt sind) ---
# Die Datenbank ist immer nur ueber 127.0.0.1 erreichbar.
POSTGRES_PORT=5432
API_PORT=8000

# --- Datenbankrollen ---
# Lokal ohne Docker-API: App-Rolle in DATABASE_URL, Owner hier.
# (Im Docker-Compose-Betrieb setzt docker-compose.yml beides selbst.)
# MIGRATION_DATABASE_URL=postgresql+psycopg://mailagent:POSTGRES_PASSWORD_HIER@127.0.0.1:5432/mailagent
# Passwort der App-Rolle mailagent_app. Pflicht fuer Docker Compose, URL-sichere Zeichen.
APP_DB_PASSWORD=

# --- Mandanten & Sicherheit ---
# Schluessel fuer die verschluesselten Postfach-Passwoerter.
# Erzeugen: python -m app.admin generate-key   (NIE aendern, sobald Postfaecher angelegt sind)
ENCRYPTION_KEY=
# Erster Admin-Nutzer - wird nur angelegt, solange es noch keinen Nutzer gibt
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Putzplan per WhatsApp (Twilio) ---
# Ohne diese drei Werte wird nichts verschickt; Mitarbeiter und Vorschau gehen trotzdem.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox: whatsapp:+14155238886 - im Betrieb die eigene, bei Meta registrierte Nummer
TWILIO_WHATSAPP_FROM=
# Freigegebene WhatsApp-Vorlage (Content SID "HX...") mit {{1}} Name, {{2}} Titel, {{3}} Plan.
# Leer = freier Text: kommt nur in der Sandbox bzw. 24 h nach einer Nachricht des Mitarbeiters an.
TWILIO_CONTENT_SID=
# Optional eigene Vorlage fuer Aenderungen nach dem Versand (sonst TWILIO_CONTENT_SID)
TWILIO_UPDATE_CONTENT_SID=
# Vorwahl fuer Nummern wie "0171 1234567"
PHONE_DEFAULT_COUNTRY_CODE=49
# Wie WATCH_ENABLED: bei mehreren Instanzen nur auf einer den Putzplan versenden
CLEANING_DISPATCH_ENABLED=true
# --- Versand der Einmalcodes (Bestaetigung, Passwort-Reset) ---
# Ohne SMTP_HOST wird nichts verschickt - der Code steht dann im Server-Log.
# Das ist nur fuer die Entwicklung gedacht.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Absender, z.B. Mail Agent <noreply@example.de>  (leer = SMTP_USER)
SMTP_FROM=
# true: Port 587 mit STARTTLS | false: Port 465 mit SSL von Anfang an
SMTP_STARTTLS=true

# --- Registrierung ---
# false: niemand kann sich selbst registrieren, Nutzer nur per python -m app.admin
SIGNUP_ENABLED=true

# --- Weboberflaeche ---
SESSION_HOURS=12
# Hinter HTTPS auf true setzen
COOKIE_SECURE=false

# --- Sonstiges ---
SAMPLE_EMAILS_DIR=data/sample_emails
EXPORTS_DIR=data/exports
# Import-Ordner je Mandant: <IMPORTS_DIR>/tenant-<id>/
IMPORTS_DIR=data/imports
LOG_LEVEL=INFO
