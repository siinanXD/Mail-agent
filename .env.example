# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- PostgreSQL ---
# lokal (ohne Docker-API-Container):
DATABASE_URL=postgresql+psycopg://mailagent:mailagent@localhost:5432/mailagent

# --- Langfuse (optional, App startet auch ohne) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- IMAP-Postfach (Dauerbetrieb) ---
# Outlook: outlook.office365.com | Gmail: imap.gmail.com (App-Passwort noetig)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_SSL=true
# Nur Mails ab diesem Datum holen, z.B. 2026-09-01 (leer = alle im Ordner)
IMAP_SINCE=

# --- Automatischer Abruf ---
WATCH_ENABLED=true
# Uhrzeiten in lokaler Serverzeit (siehe TZ), kommagetrennt
POLL_TIMES=00:00,12:00,18:00
POLL_BATCH_SIZE=50
# Zeitzone des Containers - bestimmt, wann POLL_TIMES feuert
TZ=Europe/Berlin

# --- Docker Host-Ports (nur falls die Standardports belegt sind) ---
POSTGRES_PORT=5432
API_PORT=8000

# --- Datenbankrollen ---
# Lokal ohne Docker-API: App-Rolle in DATABASE_URL, Owner hier.
# (Im Docker-Compose-Betrieb setzt docker-compose.yml beides selbst.)
# MIGRATION_DATABASE_URL=postgresql+psycopg://mailagent:mailagent@localhost:5432/mailagent
# Passwort der App-Rolle mailagent_app (Docker Compose)
APP_DB_PASSWORD=

# --- Mandanten & Sicherheit ---
# Schluessel fuer die verschluesselten Postfach-Passwoerter.
# Erzeugen: python -m app.admin generate-key   (NIE aendern, sobald Postfaecher angelegt sind)
ENCRYPTION_KEY=
# Erster Admin-Nutzer - wird nur angelegt, solange es noch keinen Nutzer gibt
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Weboberflaeche ---
SESSION_HOURS=12
# Hinter HTTPS auf true setzen
COOKIE_SECURE=false

# --- Sonstiges ---
SAMPLE_EMAILS_DIR=data/sample_emails
EXPORTS_DIR=data/exports
LOG_LEVEL=INFO
